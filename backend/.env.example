# Shiftly Backend Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
ENABLE_DOCS=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_ANALYZE_PER_MINUTE=10
RATE_LIMIT_PROJECTS_WRITE_PER_MINUTE=30
RATE_LIMIT_RECOVERY_PER_MINUTE=5
MAX_INPUT_TEXT_CHARS=200000
GUEST_MAX_TEXT_CHAR_COUNT=3000
GUEST_MAX_FILE_CHAR_COUNT=1500

# Gemini AI Provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase PostgreSQL (Project Memory)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
DATABASE_URL=

# Supabase Administrative Key (Strictly Server-Side for MVP Password Recovery)
# SECURITY REQUIREMENTS:
# - NEVER expose to frontend or NEXT_PUBLIC_* variables.
# - NEVER log or commit this key to version control.
# - Used ONLY by server-side password-recovery endpoint to update auth.users.
SUPABASE_SERVICE_ROLE_KEY=
