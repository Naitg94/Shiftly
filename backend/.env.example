# Shiftly Backend Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
ENABLE_DOCS=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_ANALYZE_PER_MINUTE=10
RATE_LIMIT_PROJECTS_WRITE_PER_MINUTE=30
MAX_INPUT_TEXT_CHARS=200000
GUEST_MAX_TEXT_CHAR_COUNT=3000

# Gemini AI Provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase PostgreSQL (Project Memory)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
DATABASE_URL=
